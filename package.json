{
  "name": "@tomwesley/arcade-graphics-engine",
  "version": "0.2.0",
  "description": "Sleek futuristic graphics engine and UI style library for browser arcade games",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js",
      "require": "./dist/style/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js",
      "require": "./dist/pipeline/index.cjs"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js",
      "require": "./dist/integration/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:charizard": "npx http-server tests/charizard -p 8081 -o",
    "test:hud": "npx http-server tests/hud-dashboard -p 8082 -o",
    "test:consistency": "npx http-server tests/consistency -p 8083 -o",
    "test:pixelart": "npx http-server tests/pixelart-test -p 8084 -o",
    "test:style-match": "npx http-server tests/style-match -p 8085 -o",
    "test:menu": "npx http-server tests/menu-gen -p 8086 -o",
    "test:icons": "npx http-server tests/icons -p 8087 -o",
    "test:space": "npx http-server tests/space-scene -p 8088 -o",
    "test:charizard2": "npx http-server tests/charizard-sprite -p 8089 -o",
    "test:convert": "npx http-server tests/convert -p 8090 -o",
    "test:mainmenu": "npx http-server tests/main-menu -p 8091 -o",
    "test:iconlib": "npx http-server tests/icon-library -p 8092 -o",
    "test:favicon": "npx http-server tests/favicon -p 8093 -o",
    "test:homepage": "npx http-server . -p 8094 -o /tests/fake-game-home/index.html",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/integration-test/test-integration.mjs",
    "test:integration-browser": "npx http-server . -p 9000 -o /tests/integration-test/index.html",
    "eval": "npx tsx src/eval/capture-and-eval.ts",
    "eval:favicon": "npx tsx src/eval/capture-and-eval.ts tests/favicon/favicon.svg favicon 'Capital W in hexagonal HUD frame with neon glow'"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "graphics-engine",
    "game-engine",
    "hud",
    "sci-fi",
    "futuristic",
    "canvas",
    "ui",
    "arcade"
  ],
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "dotenv": "^17.4.2",
    "puppeteer": "^24.43.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
