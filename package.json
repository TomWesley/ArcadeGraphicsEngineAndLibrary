{
  "name": "@tomwesley/arcade-graphics-engine",
  "version": "0.1.0",
  "description": "Neon-glow pixel art graphics engine and style library for arcade games",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style": {
      "import": "./dist/style/index.mjs",
      "require": "./dist/style/index.js"
    },
    "./engine": {
      "import": "./dist/engine/index.mjs",
      "require": "./dist/engine/index.js"
    },
    "./components": {
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./pipeline": {
      "import": "./dist/pipeline/index.mjs",
      "require": "./dist/pipeline/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:charizard": "npx http-server tests/charizard -p 8081 -o",
    "test:hud": "npx http-server tests/hud-dashboard -p 8082 -o",
    "test:consistency": "npx http-server tests/consistency -p 8083 -o",
    "test:pixelart": "npx http-server tests/pixelart-test -p 8084 -o",
    "test:style-match": "npx http-server tests/style-match -p 8085 -o",
    "test:menu": "npx http-server tests/menu-gen -p 8086 -o",
    "test:icons": "npx http-server tests/icons -p 8087 -o",
    "test:space": "npx http-server tests/space-scene -p 8088 -o",
    "test:charizard2": "npx http-server tests/charizard-sprite -p 8089 -o",
    "test:convert": "npx http-server tests/convert -p 8090 -o",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "pixel-art",
    "neon",
    "arcade",
    "graphics-engine",
    "game-engine",
    "canvas",
    "sprites"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
